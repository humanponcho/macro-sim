{
  "model": "Macro-Sim Economic Model",
  "version": "1.0",
  "tick": "quarter",
  "purpose": "Teaching model. Deterministic. Not a forecast.",
  "baseline": {
    "growth": 2.0,
    "inflation": 2.0,
    "policyRate": 3.5,
    "treasuryYield": 3.8,
    "dollar": 100.0,
    "credit": 100.0,
    "energy": 100.0,
    "equity": 100.0
  },
  "units": {
    "growth": "percent annualised real GDP",
    "inflation": "percent year-on-year",
    "policyRate": "percent",
    "treasuryYield": "percent, 10-year analogue",
    "dollar": "index, 100 = baseline",
    "credit": "index, 100 = neutral; higher = easier",
    "energy": "index, 100 = baseline",
    "equity": "index, 100 = baseline valuation"
  },
  "bounds": {
    "growth": [-4, 6],
    "inflation": [-1, 15],
    "policyRate": [0, 12],
    "treasuryYield": [0.2, 15],
    "dollar": [70, 140],
    "credit": [60, 140],
    "energy": [40, 250],
    "equity": [40, 180]
  },
  "lagConvention": "lagQuarters=1 reads the previous completed quarter. width is the number of lagged observations averaged (payout ramp).",
  "expectations": {
    "g_exp": "2.0 - 0.30*r_gap + 0.05*credit_gap - 0.025*supply_gap + 0.45*growth_gap",
    "pi_exp": "2.0 + 0.45*inflation_gap + 0.04*supply_gap + 0.15*(g_exp-2) - 0.15*r_gap"
  },
  "equations": {
    "treasuryYield": "3.80 + 0.70*r_gap + 0.40*(pi_exp-2) + 0.20*(g_exp-2)",
    "dollar": "100 + 2.50*r_gap + 1.20*(g_exp-2) + 0.10*supply_gap",
    "equity": "100 - 6.0*(yield-3.80) + 8.0*(g_exp-2) + 0.12*credit_gap - 0.22*energy_gap",
    "energy": "100 + supply_gap + 4.0*MA(growth_gap, lag=1, width=2) - 0.35*dollar_gap_now",
    "credit": "100 - 4.0*MA(r_gap, lag=1, width=2) + 2.5*MA(growth_gap, lag=1, width=2) - 0.20*MA(dollar_gap, lag=1, width=2)",
    "growth": "2.0 + 0.07*MA(credit_gap, lag=1, width=3) - 0.035*MA(energy_gap, lag=1, width=3) + 0.015*MA(equity_gap, lag=1, width=3)",
    "inflation": "2.0 + 0.50*inflation_gap_prev + 0.05*MA(energy_gap, lag=1, width=2) + 0.25*MA(growth_gap, lag=3, width=3) - 0.03*MA(dollar_gap, lag=2, width=3)"
  },
  "links": [
    {"id": "r_to_gexp", "from": "policyRate", "to": "g_exp", "sign": -1, "beta": 0.30, "lagQuarters": 0, "width": 1, "form": "level"},
    {"id": "cred_to_gexp", "from": "credit", "to": "g_exp", "sign": 1, "beta": 0.05, "lagQuarters": 0, "width": 1, "form": "level"},
    {"id": "supply_to_gexp", "from": "energySupply", "to": "g_exp", "sign": -1, "beta": 0.025, "lagQuarters": 0, "width": 1, "form": "level"},
    {"id": "g_to_gexp", "from": "growth", "to": "g_exp", "sign": 1, "beta": 0.45, "lagQuarters": 0, "width": 1, "form": "level"},
    {"id": "pi_to_piexp", "from": "inflation", "to": "pi_exp", "sign": 1, "beta": 0.45, "lagQuarters": 0, "width": 1, "form": "level"},
    {"id": "supply_to_piexp", "from": "energySupply", "to": "pi_exp", "sign": 1, "beta": 0.04, "lagQuarters": 0, "width": 1, "form": "level"},
    {"id": "gexp_to_piexp", "from": "g_exp", "to": "pi_exp", "sign": 1, "beta": 0.15, "lagQuarters": 0, "width": 1, "form": "level"},
    {"id": "r_to_piexp", "from": "policyRate", "to": "pi_exp", "sign": -1, "beta": 0.15, "lagQuarters": 0, "width": 1, "form": "level"},
    {"id": "r_to_y", "from": "policyRate", "to": "treasuryYield", "sign": 1, "beta": 0.70, "lagQuarters": 0, "width": 1, "form": "level"},
    {"id": "piexp_to_y", "from": "pi_exp", "to": "treasuryYield", "sign": 1, "beta": 0.40, "lagQuarters": 0, "width": 1, "form": "level"},
    {"id": "gexp_to_y", "from": "g_exp", "to": "treasuryYield", "sign": 1, "beta": 0.20, "lagQuarters": 0, "width": 1, "form": "level"},
    {"id": "r_to_usd", "from": "policyRate", "to": "dollar", "sign": 1, "beta": 2.50, "lagQuarters": 0, "width": 1, "form": "level"},
    {"id": "gexp_to_usd", "from": "g_exp", "to": "dollar", "sign": 1, "beta": 1.20, "lagQuarters": 0, "width": 1, "form": "level"},
    {"id": "supply_to_usd", "from": "energySupply", "to": "dollar", "sign": 1, "beta": 0.10, "lagQuarters": 0, "width": 1, "form": "level"},
    {"id": "y_to_eq", "from": "treasuryYield", "to": "equity", "sign": -1, "beta": 6.0, "lagQuarters": 0, "width": 1, "form": "level"},
    {"id": "gexp_to_eq", "from": "g_exp", "to": "equity", "sign": 1, "beta": 8.0, "lagQuarters": 0, "width": 1, "form": "level"},
    {"id": "cred_to_eq", "from": "credit", "to": "equity", "sign": 1, "beta": 0.12, "lagQuarters": 0, "width": 1, "form": "level"},
    {"id": "e_to_eq", "from": "energy", "to": "equity", "sign": -1, "beta": 0.22, "lagQuarters": 0, "width": 1, "form": "level"},
    {"id": "r_to_cred", "from": "policyRate", "to": "credit", "sign": -1, "beta": 4.0, "lagQuarters": 1, "width": 2, "form": "delayed_level"},
    {"id": "g_to_cred", "from": "growth", "to": "credit", "sign": 1, "beta": 2.5, "lagQuarters": 1, "width": 2, "form": "delayed_level"},
    {"id": "usd_to_cred", "from": "dollar", "to": "credit", "sign": -1, "beta": 0.20, "lagQuarters": 1, "width": 2, "form": "delayed_level"},
    {"id": "cred_to_g", "from": "credit", "to": "growth", "sign": 1, "beta": 0.07, "lagQuarters": 1, "width": 3, "form": "delayed_level"},
    {"id": "e_to_g", "from": "energy", "to": "growth", "sign": -1, "beta": 0.035, "lagQuarters": 1, "width": 3, "form": "delayed_level"},
    {"id": "eq_to_g", "from": "equity", "to": "growth", "sign": 1, "beta": 0.015, "lagQuarters": 1, "width": 3, "form": "delayed_level"},
    {"id": "pi_ar", "from": "inflation", "to": "inflation", "sign": 1, "beta": 0.50, "lagQuarters": 1, "width": 1, "form": "persistence"},
    {"id": "e_to_pi", "from": "energy", "to": "inflation", "sign": 1, "beta": 0.05, "lagQuarters": 1, "width": 2, "form": "delayed_level"},
    {"id": "g_to_pi", "from": "growth", "to": "inflation", "sign": 1, "beta": 0.25, "lagQuarters": 3, "width": 3, "form": "delayed_level"},
    {"id": "usd_to_pi", "from": "dollar", "to": "inflation", "sign": -1, "beta": 0.03, "lagQuarters": 2, "width": 3, "form": "delayed_level"},
    {"id": "supply_to_e", "from": "energySupply", "to": "energy", "sign": 1, "beta": 1.0, "lagQuarters": 0, "width": 1, "form": "level"},
    {"id": "g_to_e", "from": "growth", "to": "energy", "sign": 1, "beta": 4.0, "lagQuarters": 1, "width": 2, "form": "delayed_level"},
    {"id": "usd_to_e", "from": "dollar", "to": "energy", "sign": -1, "beta": 0.35, "lagQuarters": 0, "width": 1, "form": "level"}
  ],
  "taylorRule": {
    "enabledDefault": false,
    "rStar": 3.5,
    "piStar": 2.0,
    "gStar": 2.0,
    "weightInflation": 1.5,
    "weightGrowth": 0.5,
    "maxStepPerQuarter": 0.5,
    "formula": "r_desired = 3.50 + 1.5*(pi_exp-2) + 0.5*(g_exp-2)"
  },
  "orderOfComputation": [
    "applyInputs",
    "expectations",
    "optionalTaylorThenRecomputeExpectations",
    "treasuryYield",
    "dollar",
    "energy",
    "credit",
    "growth",
    "inflation",
    "equity",
    "clip",
    "appendGapHistory",
    "snapshot"
  ]
}
